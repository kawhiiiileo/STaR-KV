# Copy to examples/starkv_local_paths.env and replace every path you use.

STARKV_PYTHON=/absolute/path/to/python
UITARS_MODEL_PATH=/absolute/path/to/UI-TARS-1.5-7B
OPENCUA_MODEL_PATH=/absolute/path/to/OpenCUA-7B

SCREENSPOTPRO_IMGS=/absolute/path/to/ScreenSpot-Pro/images
SCREENSPOTPRO_TEST=/absolute/path/to/ScreenSpot-Pro/annotations
SCREENSPOTV2_IMGS=/absolute/path/to/ScreenSpot-v2/images
SCREENSPOTV2_TEST=/absolute/path/to/ScreenSpot-v2/annotations
ANDROIDCONTROL_IMGS=/absolute/path/to/AndroidControl
ANDROIDCONTROL_TEST=/absolute/path/to/AndroidControl/data
ANB_DATA=/absolute/path/to/AgentNetBench/test_data
ANB_IMGS=/absolute/path/to/AgentNetBench/test_data/images
